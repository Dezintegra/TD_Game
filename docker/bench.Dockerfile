# syntax=docker/dockerfile:1

# Образ для счётных замеров.
#
# Нужен ради одного: выделенной доли процессора. Замер стоимости тика
# на рабочей машине зависит от того, чем она занята в эту минуту, —
# 23.08.2026 из-за этого стоимость решения ИИ вышла завышенной вдесятеро.
# Контейнер с `--cpus` даёт один и тот же бюджет от прогона к прогону,
# поэтому цифры становятся сравнимыми между собой.
#
# Чего он НЕ даёт — тишины на машине. Если хост занят, ядер меньше
# не станет ни у кого, и замер останется шумным; проверка занятости
# внутри контейнера поэтому не отключена. Подробности — в bench.md.
#
# Для кадров в секунду этот образ не годится вовсе: видеокарты внутри нет,
# Chromium рисовал бы программно.

FROM node:22-slim

# corepack ставит pnpm той версии, что записана в `packageManager`,
# то есть ровно ту же, что на машине разработчика. Разные версии
# устанавливали бы по-разному, и сравнивать замеры стало бы не с чем.
RUN corepack enable

WORKDIR /repo

# `.dockerignore` уже вырезает node_modules и dist с хоста: они собраны
# под Windows, а здесь Linux. Заодно оттуда вырезана и история git —
# поэтому scripts/perf-common.mjs умеет работать без неё.
COPY . .

RUN pnpm install --frozen-lockfile

# Собирается только то, что нужно замеру: @td/ai вместе с зависимостями,
# которые turbo подтянет сам по `dependsOn: ["^build"]`. Клиент с его
# сборкой Vite здесь не нужен и занял бы минуты впустую.
RUN pnpm exec turbo run build --filter=@td/ai --filter=@td/sim

# Журнал пишется на смонтированный каталог: иначе он исчез бы вместе
# с контейнером, а весь смысл замера — в сравнении с прошлыми.
ENV PERF_LOG=/results/perf-log.jsonl

ENTRYPOINT ["node", "scripts/bench-tick.mjs"]
