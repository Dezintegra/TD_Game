# Настройки боевого запуска. Скопируйте в `.env` и правьте там:
# `.env` не под системой контроля версий, `.env.example` — под ней.
#
#   cp .env.example .env

# Домен, на котором живёт игра. Обязателен: его имя попадает в пути
# к сертификату Let's Encrypt, и без него контейнер веба не поднимется.
# Домен должен УЖЕ указывать на этот сервер — проверка владения идёт
# обычным запросом по 80-му порту.
TD_DOMAIN=dezintegra.net

# На каких портах хоста слышна игра. Восемьдесят и четыреста сорок три —
# не прихоть: голый HTTP нужен для проверки Let's Encrypt и для переезда
# на HTTPS, а на нестандартном порту ни то, ни другое не работает.
WEB_PORT=80
TLS_PORT=443

# Куда клиенту стучаться за комнатами и матчем.
#
# Пусто и /game — это «туда же, откуда пришла страница»: nginx сам
# передаст запрос серверу. Заполнять их нужно, только если сервер вынесен
# на отдельный адрес, например api.example.com. Значения вшиваются
# в бандл на сборке, поэтому после правки нужен `--build`.
VITE_API_URL=
VITE_WS_URL=/game

# Писать ли партии на диск — решение владельца службы, и принимается оно
# здесь, при развёртывании. В образце выключено: образец не знает, чей
# сервер с него поднимут, и включать запись за будущего владельца молча
# не должен. Включите (MATCHLOG=1), если хотите разбирать матчи ареной;
# записи лягут в том `matchlog`.
MATCHLOG=0

# Показания производительности, наоборот, по умолчанию СОХРАНЯЮТСЯ, и эта
# разница с записью матчей намеренная. Запись хранит ход чужой партии —
# включать её решает владелец. Показания обезличены (матч и сторона, без
# прозвищ, комнат и билетов), ограничены сверху числом строк на матч
# и нужны ровно тому, кто службу и держит: без них вопрос «что было в той
# партии, где дёргалось» остаётся без ответа.
#
# Сказано здесь потому, что умолчание включающее: узнать о нём из одних
# исходников владелец не обязан. Выключается TELEMETRY=0; записи лягут
# в том `telemetry`, отдельный от `matchlog`.
TELEMETRY=1

# Общий секрет, которым служба компьютерных дежурных заверяет свои
# личности перед сервером. Сервер обязан знать, кто из игроков компьютер:
# иначе комнату нечем пометить, а врать игроку о том, с кем он играет,
# нельзя.
#
# ПУСТОЕ значение означает, что регистрация закрыта: служба не поднимет
# ни одного дежурного и скажет об этом в журнале, а игра с компьютером
# будет недоступна. Комнаты при этом не появятся вовсе — и это лучше,
# чем комнаты компьютера без пометки: игрок сел бы играть с компьютером,
# думая, что играет с человеком.
#
# Умолчание пустое намеренно. Секрет вида `changeme` однажды доехал бы
# до боевой машины, и никто не заметил бы, пока не стало поздно. Задайте
# любую случайную строку подлиннее, например `openssl rand -hex 24`.
COMPUTER_SECRET=
