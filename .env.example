# Настройки боевого запуска. Скопируйте в `.env` и правьте там:
# `.env` не под системой контроля версий, `.env.example` — под ней.
#
#   cp .env.example .env

# Домен, на котором живёт игра. Обязателен: его имя попадает в пути
# к сертификату Let's Encrypt, и без него контейнер веба не поднимется.
# Домен должен УЖЕ указывать на этот сервер — проверка владения идёт
# обычным запросом по 80-му порту.
TD_DOMAIN=dezintegra.net

# На каких портах хоста слышна игра. Восемьдесят и четыреста сорок три —
# не прихоть: голый HTTP нужен для проверки Let's Encrypt и для переезда
# на HTTPS, а на нестандартном порту ни то, ни другое не работает.
WEB_PORT=80
TLS_PORT=443

# Куда клиенту стучаться за комнатами и матчем.
#
# Пусто и /game — это «туда же, откуда пришла страница»: nginx сам
# передаст запрос серверу. Заполнять их нужно, только если сервер вынесен
# на отдельный адрес, например api.example.com. Значения вшиваются
# в бандл на сборке, поэтому после правки нужен `--build`.
VITE_API_URL=
VITE_WS_URL=/game

# Писать ли партии на диск. Выключено: пока не решён вопрос о согласии
# игрока на запись, сервер, доступный посторонним, партий не пишет.
# Включите (MATCHLOG=1), если поднимаете сборку для себя и хотите
# разбирать матчи ареной; записи лягут в том `matchlog`.
MATCHLOG=0
