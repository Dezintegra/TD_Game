# Свои правила концов строк, а не запись в корневом файле проекта.
#
# Инструмент переносится копированием каталога, и правила должны ехать
# вместе с ним: в чужом репозитории корневого `.gitattributes` может
# не быть вовсе, а `core.autocrlf` на чужой машине настроен как угодно.

# Батнику нужны CRLF. Не для красоты: cmd.exe спотыкается на переходах
# `goto` в файле с одними переводами строки, и ломается это не сразу,
# а на той ветке, куда переход ведёт, — то есть в редком случае.
*.cmd text eol=crlf
*.bat text eol=crlf

# Сценарию оболочки, наоборот, нужны LF. Возврат каретки прилипает
# к строке `#!/usr/bin/env sh`, и запуск падает с невнятным
# «bad interpreter: no such file or directory».
*.sh text eol=lf
