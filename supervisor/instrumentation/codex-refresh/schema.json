{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "refresh-boundary/v1 frame payload",
  "description": "Transport validation only. Acceptance requires independent provenance and causal coverage validation. Wire: uint32 LE JSON byte length, UTF-8 JSON, raw SHA-256 of JSON (32 bytes). Seal hashes preceding complete frames of its writer in sequence order.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "format": "uint64"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostId", "pid", "creationTime", "helperInstanceId"],
      "properties": {
        "hostId": {
          "$ref": "#/$defs/id"
        },
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "creationTime": {
          "$ref": "#/$defs/u64"
        },
        "helperInstanceId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "tid", "creationTime", "threadInstanceId"],
      "properties": {
        "process": {
          "$ref": "#/$defs/process"
        },
        "tid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "creationTime": {
          "$ref": "#/$defs/u64"
        },
        "threadInstanceId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "threadOpenError",
        "tokenId",
        "authenticationId",
        "modifiedId",
        "modifiedIdBefore",
        "modifiedIdAfter",
        "tokenType",
        "user",
        "groups",
        "restrictedSids",
        "privileges",
        "integrity",
        "elevationType",
        "elevated",
        "impersonationLevel",
        "isAppContainer",
        "appContainerSid",
        "capabilities"
      ],
      "properties": {
        "selection": {
          "enum": ["thread", "process-after-no-token"]
        },
        "threadOpenError": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          ]
        },
        "tokenId": {
          "$ref": "#/$defs/u64"
        },
        "authenticationId": {
          "$ref": "#/$defs/u64"
        },
        "modifiedId": {
          "$ref": "#/$defs/u64"
        },
        "modifiedIdBefore": {
          "$ref": "#/$defs/u64"
        },
        "modifiedIdAfter": {
          "$ref": "#/$defs/u64"
        },
        "tokenType": {
          "enum": ["primary", "impersonation"]
        },
        "user": {
          "type": "string",
          "pattern": "^S-[0-9]+(-[0-9]+)+$",
          "maxLength": 184
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sid", "attributes"],
            "properties": {
              "sid": {
                "type": "string",
                "pattern": "^S-[0-9]+(-[0-9]+)+$",
                "maxLength": 184
              },
              "attributes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          },
          "maxItems": 4096
        },
        "restrictedSids": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sid", "attributes"],
            "properties": {
              "sid": {
                "type": "string",
                "pattern": "^S-[0-9]+(-[0-9]+)+$",
                "maxLength": 184
              },
              "attributes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          },
          "maxItems": 4096
        },
        "privileges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["luid", "attributes"],
            "properties": {
              "luid": {
                "$ref": "#/$defs/u64"
              },
              "attributes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          },
          "maxItems": 4096
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sid", "attributes"],
          "properties": {
            "sid": {
              "type": "string",
              "pattern": "^S-[0-9]+(-[0-9]+)+$",
              "maxLength": 184
            },
            "attributes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "elevationType": {
          "enum": ["default", "full", "limited"]
        },
        "elevated": {
          "type": "boolean"
        },
        "impersonationLevel": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": ["anonymous", "identification", "impersonation", "delegation"]
            }
          ]
        },
        "isAppContainer": {
          "type": "boolean"
        },
        "appContainerSid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^S-[0-9]+(-[0-9]+)+$",
              "maxLength": 184
            }
          ]
        },
        "capabilities": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sid", "attributes"],
                "properties": {
                  "sid": {
                    "type": "string",
                    "pattern": "^S-[0-9]+(-[0-9]+)+$",
                    "maxLength": 184
                  },
                  "attributes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                }
              },
              "maxItems": 4096
            }
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "writerId",
