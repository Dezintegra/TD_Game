+                matches!(snapshot(&mut api),Err(ObservationError::Unavailable(QueryError{api:"OpenThreadToken",code:actual})) if actual==code)
+            );
+            assert_eq!(api.process_opens, 0);
+            assert_eq!(api.drops.get(), 0);
+        }
+    }
+    #[test]
+    fn refresh_boundary_token_no_token_is_only_fallback() {
+        let mut api = Fake {
+            thread_error: Some(ERROR_NO_TOKEN),
+            ..Default::default()
+        };
+        let captured = snapshot(&mut api).unwrap();
+        assert_eq!(captured.snapshot.selection, Selection::ProcessAfterNoToken);
+        assert_eq!(api.process_opens, 1);
+        assert_eq!(api.drops.get(), 0);
+        drop(captured);
+        assert_eq!(api.drops.get(), 1);
+        api.process_error = Some(5);
+        assert!(matches!(
+            snapshot(&mut api),
+            Err(ObservationError::Unavailable(QueryError {
+                api: "OpenProcessToken",
+                code: 5
+            }))
+        ));
+    }
+    #[test]
+    fn refresh_boundary_token_failed_field_closes_handle() {
+        let mut api = Fake {
+            field_error: true,
+            ..Default::default()
+        };
+        assert!(matches!(
+            snapshot(&mut api),
+            Err(ObservationError::Unavailable(_))
+        ));
+        assert_eq!(api.drops.get(), 1);
+        api.field_error = false;
+        api.incomplete_fields = true;
+        assert!(matches!(
+            snapshot(&mut api),
+            Err(ObservationError::InvalidFields)
+        ));
+        assert_eq!(api.drops.get(), 2);
+    }
+    #[test]
+    fn refresh_boundary_token_snapshot_change_is_unstable() {
+        let mut api = Fake {
+            change_at: Some(2),
+            ..Default::default()
+        };
+        assert!(matches!(
+            snapshot(&mut api),
+            Err(ObservationError::Unstable)
+        ));
+        assert_eq!(api.drops.get(), 1);
+    }
+    #[test]
+    fn refresh_boundary_token_after_call_reselects_and_detects_change() {
+        let mut api = Fake::default();
+        let before = snapshot(&mut api).unwrap();
+        let after = snapshot(&mut api).unwrap();
+        assert!(same_effective_token(&before.snapshot, &after.snapshot));
+        api.change_at = Some(5);
+        let changed = snapshot(&mut api).unwrap();
+        assert!(!same_effective_token(&before.snapshot, &changed.snapshot));
+        api.change_at = None;
+        api.thread_error = Some(ERROR_NO_TOKEN);
+        let switched = snapshot(&mut api).unwrap();
+        assert!(!same_effective_token(&before.snapshot, &switched.snapshot));
+        assert_eq!(api.drops.get(), 0);
+        drop((before, after, changed, switched));
+        assert_eq!(api.drops.get(), 4);
+    }
+
+    #[test]
+    fn refresh_boundary_token_wire_snapshot_is_allowlisted_and_lossless() {
+        let mut api = Fake {
+            thread_error: Some(ERROR_NO_TOKEN),
+            ..Default::default()
+        };
+        let mut captured = snapshot(&mut api).unwrap();
+        captured.snapshot.stats.token_id = u64::MAX;
+        captured.snapshot.fields.groups = vec![Sid {
+            sid: "S-1-5-32-545".into(),
+            attributes: 16,
+        }];
+        captured.snapshot.fields.privileges = vec![Privilege {
+            luid: u64::MAX,
+            attributes: 2,
+        }];
+        let value = serde_json::to_value(&captured.snapshot).unwrap();
+        assert_eq!(
+            value,
+            serde_json::json!({
+                "selection":"process-after-no-token","threadOpenError":1008,
+                "tokenId":"18446744073709551615","authenticationId":"2",
+                "modifiedId":"3","modifiedIdBefore":"3","modifiedIdAfter":"3",
+                "tokenType":"primary","user":"S-1-0-0",
+                "groups":[{"sid":"S-1-5-32-545","attributes":16}],"restrictedSids":[],
+                "privileges":[{"luid":"18446744073709551615","attributes":2}],
+                "integrity":{"sid":"S-1-16-4096","attributes":0},"elevationType":"default",
+                "elevated":false,"impersonationLevel":null,"isAppContainer":false,
+                "appContainerSid":null,"capabilities":null
+            })
+        );
+        let path = std::env::var_os("REFRESH_BOUNDARY_TEST_FIXTURE")
+            .expect("driver supplies fixture path");
+        std::fs::write(path, serde_json::to_vec(&captured.snapshot).unwrap()).unwrap();
+    }
+}
