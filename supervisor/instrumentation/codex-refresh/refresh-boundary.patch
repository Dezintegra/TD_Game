+/// Token selection is isolated from snapshot serialization and syscall execution.
+/// Tests cannot fall through to native APIs: the adapter is absent under cfg(test).
+pub mod token_observer {
+    use serde::Serialize;
+
+    pub const ERROR_NO_TOKEN: u32 = 1008;
+    #[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+    #[serde(rename_all = "kebab-case")]
+    pub enum Selection {
+        Thread,
+        ProcessAfterNoToken,
+    }
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub struct QueryError {
+        pub api: &'static str,
+        pub code: u32,
+    }
+
+    pub trait TokenApi {
+        type Handle;
+        fn open_thread(&mut self) -> Result<Self::Handle, QueryError>;
+        fn open_process(&mut self) -> Result<Self::Handle, QueryError>;
+        fn statistics(&mut self, handle: &Self::Handle) -> Result<Statistics, QueryError>;
+        fn fields(
+            &mut self,
+            handle: &Self::Handle,
+            stats: &Statistics,
+        ) -> Result<Fields, QueryError>;
+    }
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub struct Statistics {
+        pub token_id: u64,
+        pub authentication_id: u64,
+        pub modified_id: u64,
+        pub impersonation: bool,
+    }
+    #[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+    pub struct Sid {
+        pub sid: String,
+        pub attributes: u32,
+    }
+    #[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+    pub struct Privilege {
+        #[serde(serialize_with = "super::decimal")]
+        pub luid: u64,
+        pub attributes: u32,
+    }
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    pub struct Fields {
+        pub user: String,
+        pub groups: Vec<Sid>,
+        pub restricted_sids: Vec<Sid>,
+        pub privileges: Vec<Privilege>,
+        pub integrity: Sid,
+        pub elevation_type: &'static str,
+        pub elevated: bool,
+        pub impersonation_level: Option<&'static str>,
+        pub is_app_container: bool,
+        pub app_container_sid: Option<String>,
+        pub capabilities: Option<Vec<Sid>>,
+    }
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    pub struct Snapshot {
+        pub selection: Selection,
+        pub stats: Statistics,
+        pub fields: Fields,
+    }
+    impl Serialize for Snapshot {
+        fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+            use serde::ser::SerializeStruct;
+            let mut record = serializer.serialize_struct("TokenSnapshot", 19)?;
+            record.serialize_field("selection", &self.selection)?;
+            record.serialize_field(
+                "threadOpenError",
+                &match self.selection {
+                    Selection::Thread => None,
+                    Selection::ProcessAfterNoToken => Some(ERROR_NO_TOKEN),
+                },
+            )?;
+            record.serialize_field("tokenId", &self.stats.token_id.to_string())?;
+            record.serialize_field(
+                "authenticationId",
+                &self.stats.authentication_id.to_string(),
+            )?;
+            record.serialize_field("modifiedId", &self.stats.modified_id.to_string())?;
+            record.serialize_field("modifiedIdBefore", &self.stats.modified_id.to_string())?;
+            record.serialize_field("modifiedIdAfter", &self.stats.modified_id.to_string())?;
+            record.serialize_field(
+                "tokenType",
+                if self.stats.impersonation {
+                    "impersonation"
+                } else {
+                    "primary"
+                },
+            )?;
+            record.serialize_field("user", &self.fields.user)?;
+            record.serialize_field("groups", &self.fields.groups)?;
+            record.serialize_field("restrictedSids", &self.fields.restricted_sids)?;
+            record.serialize_field("privileges", &self.fields.privileges)?;
+            record.serialize_field("integrity", &self.fields.integrity)?;
+            record.serialize_field("elevationType", &self.fields.elevation_type)?;
+            record.serialize_field("elevated", &self.fields.elevated)?;
+            record.serialize_field("impersonationLevel", &self.fields.impersonation_level)?;
+            record.serialize_field("isAppContainer", &self.fields.is_app_container)?;
+            record.serialize_field("appContainerSid", &self.fields.app_container_sid)?;
+            record.serialize_field("capabilities", &self.fields.capabilities)?;
+            record.end()
+        }
+    }
+
+    pub struct Captured<H> {
+        pub snapshot: Snapshot,
+        pub handle: H,
+    }
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    pub enum ObservationError {
+        Unavailable(QueryError),
+        Unstable,
+        InvalidFields,
+    }
+
+    pub fn snapshot<A: TokenApi>(api: &mut A) -> Result<Captured<A::Handle>, ObservationError> {
+        let (handle, selection) = match api.open_thread() {
+            Ok(handle) => (handle, Selection::Thread),
+            Err(QueryError {
+                code: ERROR_NO_TOKEN,
+                ..
+            }) => (
+                api.open_process().map_err(ObservationError::Unavailable)?,
+                Selection::ProcessAfterNoToken,
+            ),
+            Err(error) => return Err(ObservationError::Unavailable(error)),
+        };
+        let before = api
+            .statistics(&handle)
+            .map_err(ObservationError::Unavailable)?;
+        let fields = api
+            .fields(&handle, &before)
+            .map_err(ObservationError::Unavailable)?;
+        let after = api
+            .statistics(&handle)
+            .map_err(ObservationError::Unavailable)?;
+        if before != after {
+            return Err(ObservationError::Unstable);
+        }
+        if before.impersonation != fields.impersonation_level.is_some()
+            || fields.is_app_container != fields.app_container_sid.is_some()
+            || fields.is_app_container != fields.capabilities.is_some()
+            || fields.groups.len() > 4096
+            || fields.restricted_sids.len() > 4096
+            || fields.privileges.len() > 4096
+            || fields.capabilities.as_ref().is_some_and(|v| v.len() > 4096)
+        {
+            return Err(ObservationError::InvalidFields);
+        }
+        Ok(Captured {
+            snapshot: Snapshot {
+                selection,
+                stats: before,
+                fields,
+            },
+            handle,
+        })
+    }
+
+    pub fn same_effective_token(before: &Snapshot, after: &Snapshot) -> bool {
+        before.selection == after.selection
+            && before.stats == after.stats
+            && before.fields == after.fields
+    }
