+//! Bounded, opt-in diagnostic transport. No environment lookup or OS calls.
+//! Callsite integration and native pipe adapter are separate admission steps.
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+use std::collections::VecDeque;
+use std::sync::{Arc, Mutex};
+
+/// Passed explicitly across request/async boundaries; never ambient thread-local.
+#[derive(Clone)]
+pub struct DiagnosticContext {
+    pub call_id: Id,
+    pub attempt_id: Id,
+    writer: Arc<Mutex<Writer>>,
+    clock: Arc<dyn Fn() -> Result<ClockSample, &'static str> + Send + Sync>,
+}
+impl DiagnosticContext {
+    pub fn new(call_id: Id, attempt_id: Id, writer: Writer) -> Self {
+        Self {
+            call_id,
+            attempt_id,
+            writer: Arc::new(Mutex::new(writer)),
+            // До установки проверенного адаптера время не выдумывается.
+            clock: Arc::new(|| Err("clock-unavailable")),
+        }
+    }
+    pub fn healthy(&self) -> bool {
+        self.writer
+            .lock()
+            .map(|writer| !writer.incomplete())
+            .unwrap_or(false)
+    }
+    pub fn with_clock(
+        mut self,
+        clock: impl Fn() -> Result<ClockSample, &'static str> + Send + Sync + 'static,
+    ) -> Self {
+        self.clock = Arc::new(clock);
+        self
+    }
+    pub fn mark_incomplete(&self) {
+        if let Ok(mut writer) = self.writer.lock() {
+            writer.incomplete = true;
+        }
+    }
+    pub fn next_id(&self) -> Option<Id> {
+        let mut writer = self.writer.lock().ok()?;
+        let Some(serial) = writer.identity_serial.checked_add(1) else {
+            writer.incomplete = true;
+            return None;
+        };
+        writer.identity_serial = serial;
+        // Полный digest сохраняет ограниченную длину независимо от writerId.
+        let mut digest = Sha256::new();
+        for part in [
+            &writer.collection_id.0,
+            &writer.launch_id.0,
+            &writer.writer_id.0,
+        ] {
+            digest.update((part.len() as u64).to_le_bytes());
+            digest.update(part.as_bytes());
+        }
+        digest.update(serial.to_le_bytes());
+        Some(Id(format!("{:x}", digest.finalize())))
+    }
+    fn emit(&self, event: Event) {
+        let Ok(clock) = (self.clock)() else {
+            self.mark_incomplete();
+            return;
+        };
+        if let Ok(mut writer) = self.writer.lock() {
+            let _ = writer.enqueue(event, &clock);
+        }
+    }
+    pub fn refresh_edge(&self, refresh_id: &Id, leader: bool) {
+        let edge = RefreshEdge {
+            call_id: self.call_id.clone(),
+            attempt_id: self.attempt_id.clone(),
+            refresh_id: refresh_id.clone(),
+        };
+        self.emit(if leader {
+            Event::RefreshLeader(edge)
+        } else {
+            Event::RefreshJoin(edge)
+        });
+    }
+    pub fn refresh_end(&self, refresh_id: &Id, success: bool) {
+        self.emit(Event::RefreshEnd {
+            refresh_id: refresh_id.clone(),
+            result: if success {
+                RefreshResult::Ok
+            } else {
+                RefreshResult::Error
+            },
+        });
+    }
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct RefreshEdge {
+    call_id: Id,
+    attempt_id: Id,
+    refresh_id: Id,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum RefreshResult {
+    Ok,
+    Error,
+}
+
+pub fn record_if_enabled(
+    context: Option<&DiagnosticContext>,
+    event: impl FnOnce() -> Event,
+    clock: impl FnOnce() -> ClockSample,
+) -> Result<(), &'static str> {
+    let Some(context) = context else {
+        return Ok(());
+    };
+    context
+        .writer
+        .lock()
+        .map_err(|_| "writer-poisoned")?
+        .enqueue(event(), &clock())
+}
+
+const FRAME_LIMIT: usize = 256 * 1024;
+const QUEUE_LIMIT: usize = 1024 * 1024;
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(transparent)]
+pub struct Id(String);
+impl Id {
+    pub fn new(value: impl Into<String>) -> Result<Self, &'static str> {
+        let value = value.into();
+        if value.is_empty()
+            || value.len() > 128
+            || !value
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+        {
+            return Err("invalid-id");
+        }
+        Ok(Self(value))
+    }
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(transparent)]
+pub struct Hash(String);
+impl Hash {
+    pub fn new(value: impl Into<String>) -> Result<Self, &'static str> {
+        let value = value.into();
+        if value.len() != 64
+            || !value
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        {
+            return Err("invalid-hash");
+        }
+        Ok(Self(value))
+    }
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ProcessIdentity {
+    pub host_id: Id,
+    pub pid: u32,
+    #[serde(serialize_with = "decimal")]
+    pub creation_time: u64,
+    pub helper_instance_id: Id,
+}
+
+fn decimal<S: serde::Serializer>(value: &u64, serializer: S) -> Result<S::Ok, S::Error> {
+    serializer.serialize_str(&value.to_string())
+}
+
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum Origin {
+    Synthetic,
+    Instrumented,
+}
+
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum LossReason {
+    QueueOverflow,
+    WriteFailed,
+    FlushFailed,
+    Deadline,
+}
+
+#[derive(Clone, Copy, Debug, Serialize)]
+pub enum Api {
+    WriteFile,
+    FlushFileBuffers,
+}
+
+#[derive(Serialize)]
+#[serde(tag = "kind", content = "body")]
+pub enum Event {
+    #[serde(rename = "refresh-leader")]
+    RefreshLeader(RefreshEdge),
+    #[serde(rename = "refresh-join")]
+    RefreshJoin(RefreshEdge),
+    #[serde(rename = "refresh-end")]
+    RefreshEnd {
+        #[serde(rename = "refreshId")]
+        refresh_id: Id,
+        result: RefreshResult,
+    },
+    #[serde(rename = "handshake")]
+    Handshake {
+        origin: Origin,
+        #[serde(rename = "buildId")]
+        build_id: Hash,
+        process: ProcessIdentity,
+        #[serde(rename = "parentWriterId")]
+        parent_writer_id: Option<Id>,
+    },
+    #[serde(rename = "loss")]
+    Loss {
+        reason: LossReason,
+        api: Option<Api>,
+        code: Option<u32>,
+    },
+    #[serde(rename = "seal")]
+    Seal {
+        #[serde(serialize_with = "decimal")]
+        count: u64,
+        #[serde(rename = "finalSeq", serialize_with = "decimal")]
+        final_seq: u64,
+        sha256: Hash,
+        #[serde(serialize_with = "decimal")]
+        dropped: u64,
+        status: &'static str,
+    },
+}
+
+#[derive(Clone)]
+pub struct ClockSample {
+    pub ticks: u64,
+    pub frequency: u64,
+    pub utc: String,
+}
+impl ClockSample {
+    fn validate(&self) -> Result<(), &'static str> {
+        // The clock adapter owns calendar validity. Shape/ASCII is enforced here
+        // to prevent a raw external string from entering the diagnostic channel.
+        if self.frequency == 0
+            || self.utc.len() != 24
+            || !self.utc.bytes().enumerate().all(|(i, b)| match i {
+                4 | 7 => b == b'-',
+                10 => b == b'T',
+                13 | 16 => b == b':',
+                19 => b == b'.',
+                23 => b == b'Z',
+                _ => b.is_ascii_digit(),
+            })
+        {
+            return Err("invalid-clock");
+        }
+        Ok(())
+    }
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Frame<'a> {
+    schema_version: &'static str,
+    writer_id: &'a Id,
+    #[serde(serialize_with = "decimal")]
+    seq: u64,
+    collection_id: &'a Id,
+    launch_id: &'a Id,
+    #[serde(serialize_with = "decimal")]
+    qpc_ticks: u64,
+    #[serde(serialize_with = "decimal")]
+    qpc_frequency: u64,
+    utc: &'a str,
+    #[serde(flatten)]
+    event: &'a Event,
+}
+
+pub trait Sink {
+    fn write_frame(&mut self, bytes: &[u8]) -> Result<(), ()>;
+    fn flush(&mut self) -> Result<(), ()>;
+}
+
+pub struct Writer {
+    identity_serial: u64,
+    writer_id: Id,
+    collection_id: Id,
+    launch_id: Id,
+    seq: u64,
+    accepted: u64,
+    dropped: u64,
+    queue: VecDeque<Vec<u8>>,
+    queued_bytes: usize,
+    digest: Sha256,
+    started: bool,
+    sealed: bool,
+    incomplete: bool,
+}
+impl Writer {
+    pub fn new(writer_id: Id, collection_id: Id, launch_id: Id) -> Self {
+        Self {
+            writer_id,
+            collection_id,
+            launch_id,
+            seq: 0,
+            identity_serial: 0,
+            accepted: 0,
+            dropped: 0,
+            queue: VecDeque::new(),
+            queued_bytes: 0,
+            digest: Sha256::new(),
+            started: false,
+            sealed: false,
+            incomplete: false,
+        }
+    }
+    pub fn incomplete(&self) -> bool {
+        self.incomplete
+    }
+    pub fn enqueue(&mut self, event: Event, clock: &ClockSample) -> Result<(), &'static str> {
+        if matches!(event, Event::Seal { .. }) {
+            self.incomplete = true;
+            return Err("external-seal");
+        }
+        self.enqueue_internal(event, clock)
+    }
+    fn enqueue_internal(&mut self, event: Event, clock: &ClockSample) -> Result<(), &'static str> {
+        if self.sealed {
+            self.incomplete = true;
+            return Err("sealed");
+        }
+        // Assignment precedes serialization/enqueue: a rejected record cannot
+        // disappear behind a contiguous sequence number or a successful seal.
+        self.seq = match self.seq.checked_add(1) {
+            Some(seq) => seq,
+            None => {
+                self.incomplete = true;
+                return Err("sequence-overflow");
+            }
+        };
+        let result = self.encode_and_queue(&event, clock);
+        if result.is_err() {
+            self.incomplete = true;
+            self.dropped = self.dropped.saturating_add(1);
+        }
+        result
+    }
+    fn encode_and_queue(&mut self, event: &Event, clock: &ClockSample) -> Result<(), &'static str> {
+        clock.validate()?;
+        let is_handshake = matches!(event, Event::Handshake { .. });
+        let is_seal = matches!(event, Event::Seal { .. });
+        if is_handshake == self.started {
+            return Err("handshake-order");
+        }
+        if matches!(event, Event::Loss { .. }) {
+            self.incomplete = true;
+        }
+        let payload = serde_json::to_vec(&Frame {
+            schema_version: "refresh-boundary/v1",
+            writer_id: &self.writer_id,
+            seq: self.seq,
+            collection_id: &self.collection_id,
+            launch_id: &self.launch_id,
+            qpc_ticks: clock.ticks,
+            qpc_frequency: clock.frequency,
+            utc: &clock.utc,
+            event,
+        })
+        .map_err(|_| "serialize-failed")?;
+        if payload.len() + 36 > FRAME_LIMIT {
+            return Err("frame-limit");
+        }
+        if self.queued_bytes + payload.len() + 36 > QUEUE_LIMIT {
+            return Err("queue-overflow");
+        }
+        let mut bytes = Vec::with_capacity(payload.len() + 36);
+        bytes.extend_from_slice(&(payload.len() as u32).to_le_bytes());
+        bytes.extend_from_slice(&payload);
+        bytes.extend_from_slice(&Sha256::digest(&payload));
+        if !is_seal {
+            self.digest.update(&bytes);
+            self.accepted += 1;
+        }
+        self.queued_bytes += bytes.len();
+        self.queue.push_back(bytes);
+        self.started = true;
+        self.sealed = is_seal;
+        Ok(())
+    }
+    pub fn drain(&mut self, sink: &mut impl Sink) -> Result<(), &'static str> {
+        while let Some(bytes) = self.queue.pop_front() {
+            self.queued_bytes -= bytes.len();
+            if sink.write_frame(&bytes).is_err() {
+                self.incomplete = true;
+                self.dropped = self.dropped.saturating_add(1);
+                return Err("write-failed");
+            }
+        }
+        if sink.flush().is_err() {
+            self.incomplete = true;
+            return Err("flush-failed");
+        }
+        Ok(())
+    }
+    pub fn seal(&mut self, clock: &ClockSample) -> Result<(), &'static str> {
+        let digest = self.digest.clone().finalize();
+        let hash = digest
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect::<String>();
+        self.enqueue_internal(
+            Event::Seal {
+                count: self.accepted,
+                final_seq: self.seq,
+                sha256: Hash::new(hash)?,
+                dropped: self.dropped,
+                status: if self.incomplete {
+                    "incomplete"
+                } else {
+                    "complete"
+                },
+            },
+            clock,
+        )
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn flight_context() -> DiagnosticContext {
+        let mut writer = writer();
+        writer.enqueue(handshake(), &clock()).unwrap();
+        DiagnosticContext::new(id("call"), id("attempt"), writer).with_clock(|| Ok(clock()))
+    }
+    fn events(context: &DiagnosticContext) -> Vec<serde_json::Value> {
+        context
+            .writer
+            .lock()
+            .unwrap()
+            .queue
+            .iter()
+            .map(|bytes| {
+                let length = u32::from_le_bytes(bytes[..4].try_into().unwrap()) as usize;
+                serde_json::from_slice(&bytes[4..4 + length]).unwrap()
+            })
+            .collect()
+    }
+    #[test]
+    fn refresh_boundary_singleflight_join_and_new_flight() {
+        use std::sync::mpsc;
+        use std::time::Duration;
+        let (edge_tx, edge_rx) = mpsc::channel();
+        let context = flight_context().with_clock(move || {
+            edge_tx.send(()).unwrap();
+            Ok(clock())
+        });
+        let mut joiner = context.clone();
+        joiner.call_id = id("nested-call");
+        joiner.attempt_id = id("nested-attempt");
+        let (started_tx, started_rx) = mpsc::channel();
+        let (release_tx, release_rx) = mpsc::channel();
+        std::thread::scope(|scope| {
+            let leader_context = &context;
+            let leader = scope.spawn(move || {
+                crate::setup::run_setup_singleflight_observed(
+                    "refresh-boundary-concurrent".into(),
+                    Some(leader_context),
+                    |refresh_id| {
+                        assert!(refresh_id.is_some());
+                        started_tx.send(()).unwrap();
+                        release_rx.recv_timeout(Duration::from_secs(30)).unwrap();
+                        Ok(())
+                    },
+                )
+            });
+            started_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+            let joined = scope.spawn(|| {
+                crate::setup::run_setup_singleflight_observed(
+                    "refresh-boundary-concurrent".into(),
+                    Some(&joiner),
+                    |_| panic!("second spawn"),
+                )
+            });
+            edge_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+            let joined_edge = edge_rx.recv_timeout(Duration::from_secs(5));
+            // Даже испорченный observer обязан освободить fake leader:
+            // иначе мутация проверяла бы зависание стенда вместо потери edge.
+            release_tx.send(()).unwrap();
+            leader.join().unwrap().unwrap();
+            joined.join().unwrap().unwrap();
+            joined_edge.unwrap();
+        });
+        crate::setup::run_setup_singleflight_observed(
+            "refresh-boundary-concurrent".into(),
+            Some(&context),
+            |_| Ok(()),
+        )
+        .unwrap();
+        let records = events(&context);
+        let leaders: Vec<_> = records
+            .iter()
+            .filter(|x| x["kind"] == "refresh-leader")
+            .collect();
+        let joins: Vec<_> = records
+            .iter()
+            .filter(|x| x["kind"] == "refresh-join")
+            .collect();
+        assert_eq!(leaders.len(), 2);
+        assert_eq!(joins.len(), 1);
+        assert_eq!(
+            leaders[0]["body"]["refreshId"],
+            joins[0]["body"]["refreshId"]
+        );
+        assert_ne!(
+            leaders[0]["body"]["refreshId"],
+            leaders[1]["body"]["refreshId"]
+        );
+        assert_eq!(joins[0]["body"]["callId"], "nested-call");
+        assert_eq!(joins[0]["body"]["attemptId"], "nested-attempt");
+        assert_eq!(
+            records
+                .iter()
+                .filter(|x| x["kind"] == "refresh-end")
+                .count(),
+            2
+        );
+        assert!(context.healthy());
+        let mut writer = context.writer.lock().unwrap();
+        writer.seal(&clock()).unwrap();
+        let mut sink = FakeSink::default();
+        writer.drain(&mut sink).unwrap();
+        if let Some(path) = std::env::var_os("REFRESH_BOUNDARY_TEST_FIXTURE") {
+            std::fs::write(path, sink.bytes).unwrap();
+        }
+    }
+    #[test]
+    fn refresh_boundary_singleflight_error_and_observer_loss_preserve_result() {
+        let context = flight_context().with_clock(|| Err("clock-unavailable"));
+        let result = crate::setup::run_setup_singleflight_observed(
+            "refresh-boundary-error".into(),
+            Some(&context),
+            |_| Err(anyhow::anyhow!("native failure")),
+        );
+        assert_eq!(result.unwrap_err().to_string(), "native failure");
+        assert!(!context.healthy());
+        let observed = flight_context();
+        let result = crate::setup::run_setup_singleflight_observed(
+            "refresh-boundary-error".into(),
+            Some(&observed),
+            |_| Err(anyhow::anyhow!("native failure")),
+        );
+        assert!(result.is_err());
+        assert_eq!(events(&observed).last().unwrap()["body"]["result"], "error");
+    }
+    #[test]
+    fn refresh_boundary_singleflight_disabled_has_no_identity() {
+        crate::setup::run_setup_singleflight_observed(
+            "refresh-boundary-disabled".into(),
+            None,
+            |identity| {
+                assert!(identity.is_none());
+                Ok(())
+            },
+        )
+        .unwrap();
+    }
+    fn id(value: &str) -> Id {
+        Id::new(value).expect("valid fixture id")
+    }
+    fn clock() -> ClockSample {
+        ClockSample {
+            ticks: u64::MAX,
+            frequency: 10_000_000,
+            utc: "2026-09-24T00:00:00.000Z".into(),
+        }
+    }
+    fn handshake() -> Event {
+        Event::Handshake {
+            origin: Origin::Synthetic,
+            build_id: Hash::new("a".repeat(64)).unwrap(),
+            process: ProcessIdentity {
+                host_id: id("host"),
+                pid: 42,
+                creation_time: 134345678901234567,
+                helper_instance_id: id("helper"),
+            },
+            parent_writer_id: None,
+        }
+    }
+    fn writer() -> Writer {
+        Writer::new(id("root"), id("collection"), id("launch"))
+    }
+    #[derive(Default)]
+    struct FakeSink {
+        bytes: Vec<u8>,
+        write_denied: bool,
+        flush_denied: bool,
+    }
+    impl Sink for FakeSink {
+        fn write_frame(&mut self, bytes: &[u8]) -> Result<(), ()> {
+            if self.write_denied {
+                Err(())
+            } else {
+                self.bytes.extend_from_slice(bytes);
+                Ok(())
+            }
+        }
+        fn flush(&mut self) -> Result<(), ()> {
+            if self.flush_denied { Err(()) } else { Ok(()) }
+        }
+    }
+    #[test]
+    fn refresh_boundary_wire_roundtrip_fixture() {
+        let mut writer = writer();
+        let mut sink = FakeSink::default();
+        writer.enqueue(handshake(), &clock()).unwrap();
+        writer.seal(&clock()).unwrap();
+        writer.drain(&mut sink).unwrap();
+        assert!(!writer.incomplete());
+        let text = String::from_utf8_lossy(&sink.bytes);
+        assert!(text.contains("134345678901234567"));
+        assert!(text.contains("18446744073709551615"));
+        if let Some(path) = std::env::var_os("REFRESH_BOUNDARY_TEST_FIXTURE") {
+            std::fs::write(path, sink.bytes).unwrap();
+        }
+    }
+    #[test]
+    fn refresh_boundary_wire_write_failure_sticky() {
+        let mut writer = writer();
+        writer.enqueue(handshake(), &clock()).unwrap();
+        let mut sink = FakeSink {
+            write_denied: true,
+            ..Default::default()
+        };
+        assert_eq!(writer.drain(&mut sink), Err("write-failed"));
