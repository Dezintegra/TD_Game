+    #[cfg(not(test))]
+    pub mod native {
+        use super::*;
+        use std::mem::{offset_of, size_of};
+        use windows_sys::Win32::Foundation::{CloseHandle, GetLastError, HANDLE, LUID};
+        use windows_sys::Win32::Security::*;
+        use windows_sys::Win32::System::Threading::{
+            GetCurrentProcess, GetCurrentThread, OpenProcessToken, OpenThreadToken,
+        };
+
+        pub struct NativeToken;
+        pub struct OwnedToken(HANDLE);
+        impl Drop for OwnedToken {
+            fn drop(&mut self) {
+                unsafe {
+                    CloseHandle(self.0);
+                }
+            }
+        }
+        fn error(api: &'static str) -> QueryError {
+            QueryError {
+                api,
+                code: unsafe { GetLastError() },
+            }
+        }
+        fn invalid() -> QueryError {
+            QueryError {
+                api: "GetTokenInformation",
+                code: 13,
+            }
+        }
+        fn luid(v: LUID) -> u64 {
+            ((v.HighPart as u32 as u64) << 32) | v.LowPart as u64
+        }
+        // u64 storage preserves alignment; all pointer/count reads are range checked.
+        struct Info {
+            words: Vec<u64>,
+            bytes: usize,
+        }
+        impl Info {
+            fn query(handle: HANDLE, class: TOKEN_INFORMATION_CLASS) -> Result<Self, QueryError> {
+                let mut needed = 0;
+                let ok = unsafe {
+                    GetTokenInformation(handle, class, std::ptr::null_mut(), 0, &mut needed)
+                };
+                if ok != 0 || unsafe { GetLastError() } != 122 {
+                    return Err(error("GetTokenInformation"));
+                }
+                if needed == 0 || needed > 256 * 1024 {
+                    return Err(invalid());
+                }
+                let mut result = Self {
+                    words: vec![0; (needed as usize).div_ceil(8)],
+                    bytes: needed as usize,
+                };
+                let capacity = needed;
+                let ok = unsafe {
+                    GetTokenInformation(
+                        handle,
+                        class,
+                        result.words.as_mut_ptr().cast(),
+                        capacity,
+                        &mut needed,
+                    )
+                };
+                if ok == 0 {
+                    return Err(error("GetTokenInformation"));
+                }
+                if needed > capacity || needed == 0 {
+                    return Err(invalid());
+                }
+                result.bytes = needed as usize;
+                Ok(result)
+            }
+            fn read<T: Copy>(&self, offset: usize) -> Result<T, QueryError> {
+                if offset
+                    .checked_add(size_of::<T>())
+                    .is_none_or(|end| end > self.bytes)
+                {
+                    return Err(invalid());
+                }
+                Ok(unsafe {
+                    std::ptr::read_unaligned(self.words.as_ptr().cast::<u8>().add(offset).cast())
+                })
+            }
+            fn sid(&self, ptr: *mut std::ffi::c_void) -> Result<String, QueryError> {
+                let offset = (ptr as usize)
+                    .checked_sub(self.words.as_ptr() as usize)
+                    .ok_or_else(invalid)?;
+                let revision = self.read::<u8>(offset)?;
+                let count = self.read::<u8>(offset + 1)? as usize;
+                if revision != 1 || count > 15 {
+                    return Err(invalid());
+                }
+                let mut authority = 0u64;
+                for i in 2..8 {
+                    authority = (authority << 8) | self.read::<u8>(offset + i)? as u64;
+                }
+                let mut sid = format!("S-{revision}-{authority}");
+                for i in 0..count {
+                    sid.push_str(&format!("-{}", self.read::<u32>(offset + 8 + i * 4)?));
+                }
+                Ok(sid)
+            }
+            fn sid_attributes(&self, value: SID_AND_ATTRIBUTES) -> Result<Sid, QueryError> {
+                Ok(Sid {
+                    sid: self.sid(value.Sid)?,
+                    attributes: value.Attributes,
+                })
+            }
+            fn groups(&self) -> Result<Vec<Sid>, QueryError> {
+                let count = self.read::<u32>(0)? as usize;
+                if count > 4096 {
+                    return Err(invalid());
+                }
+                (0..count)
+                    .map(|i| {
+                        self.sid_attributes(self.read::<SID_AND_ATTRIBUTES>(
+                            offset_of!(TOKEN_GROUPS, Groups) + i * size_of::<SID_AND_ATTRIBUTES>(),
+                        )?)
+                    })
+                    .collect()
+            }
+        }
+        impl TokenApi for NativeToken {
+            type Handle = OwnedToken;
+            fn open_thread(&mut self) -> Result<OwnedToken, QueryError> {
+                let mut handle = 0;
+                if unsafe { OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, 0, &mut handle) } == 0
+                {
+                    return Err(error("OpenThreadToken"));
+                }
+                Ok(OwnedToken(handle))
+            }
+            fn open_process(&mut self) -> Result<OwnedToken, QueryError> {
+                let mut handle = 0;
+                if unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut handle) } == 0 {
+                    return Err(error("OpenProcessToken"));
+                }
+                Ok(OwnedToken(handle))
+            }
+            fn statistics(&mut self, handle: &OwnedToken) -> Result<Statistics, QueryError> {
+                let value = Info::query(handle.0, TokenStatistics)?.read::<TOKEN_STATISTICS>(0)?;
+                if value.TokenType != TokenPrimary && value.TokenType != TokenImpersonation {
+                    return Err(invalid());
+                }
+                Ok(Statistics {
+                    token_id: luid(value.TokenId),
+                    authentication_id: luid(value.AuthenticationId),
+                    modified_id: luid(value.ModifiedId),
+                    impersonation: value.TokenType == TokenImpersonation,
+                })
+            }
+            fn fields(
+                &mut self,
+                handle: &OwnedToken,
+                stats: &Statistics,
+            ) -> Result<Fields, QueryError> {
+                let query = |class| Info::query(handle.0, class);
+                let user = query(TokenUser)?;
+                let user = user.sid(user.read::<TOKEN_USER>(0)?.User.Sid)?;
+                let groups = query(TokenGroups)?.groups()?;
+                let restricted_sids = query(TokenRestrictedSids)?.groups()?;
+                let privilege_info = query(TokenPrivileges)?;
+                let count = privilege_info.read::<u32>(0)? as usize;
+                if count > 4096 {
+                    return Err(invalid());
+                }
+                let privileges = (0..count)
+                    .map(|i| {
+                        let v = privilege_info.read::<LUID_AND_ATTRIBUTES>(
+                            offset_of!(TOKEN_PRIVILEGES, Privileges)
+                                + i * size_of::<LUID_AND_ATTRIBUTES>(),
+                        )?;
+                        Ok(Privilege {
+                            luid: luid(v.Luid),
+                            attributes: v.Attributes,
+                        })
+                    })
+                    .collect::<Result<Vec<_>, QueryError>>()?;
+                let integrity = query(TokenIntegrityLevel)?;
+                let integrity =
+                    integrity.sid_attributes(integrity.read::<TOKEN_MANDATORY_LABEL>(0)?.Label)?;
+                let elevation_type = match query(TokenElevationType)?.read::<i32>(0)? {
+                    TokenElevationTypeDefault => "default",
+                    TokenElevationTypeFull => "full",
+                    TokenElevationTypeLimited => "limited",
+                    _ => return Err(invalid()),
+                };
+                let bool_field = |class| -> Result<bool, QueryError> {
+                    match query(class)?.read::<u32>(0)? {
+                        0 => Ok(false),
+                        1 => Ok(true),
+                        _ => Err(invalid()),
+                    }
+                };
+                let elevated = bool_field(TokenElevation)?;
+                let impersonation_level = if stats.impersonation {
+                    Some(match query(TokenImpersonationLevel)?.read::<i32>(0)? {
+                        SecurityAnonymous => "anonymous",
+                        SecurityIdentification => "identification",
+                        SecurityImpersonation => "impersonation",
+                        SecurityDelegation => "delegation",
+                        _ => return Err(invalid()),
+                    })
+                } else {
+                    None
+                };
+                let is_app_container = bool_field(TokenIsAppContainer)?;
+                let (app_container_sid, capabilities) = if is_app_container {
+                    let info = query(TokenAppContainerSid)?;
+                    (
+                        Some(
+                            info.sid(
+                                info.read::<TOKEN_APPCONTAINER_INFORMATION>(0)?
+                                    .TokenAppContainer,
+                            )?,
+                        ),
+                        Some(query(TokenCapabilities)?.groups()?),
+                    )
+                } else {
+                    (None, None)
+                };
+                Ok(Fields {
+                    user,
+                    groups,
+                    restricted_sids,
+                    privileges,
+                    integrity,
+                    elevation_type,
+                    elevated,
+                    impersonation_level,
+                    is_app_container,
+                    app_container_sid,
+                    capabilities,
+                })
+            }
+        }
+    }
