node_modules/
dist/
build/
.turbo/
coverage/
.env
.env.*
!.env.example
*.tsbuildinfo
playwright-report/
test-results/
.DS_Store

# Логи матчей и аналитическая база арены.
#
# Локальный рабочий материал: сотня мегабайт на пачку прогонов, и всё
# восстановимо повторным прогоном — матчи детерминированы. В репозиторий
# едут seed и профили, а не результаты их перемалывания.
.matchlog/

# Показания игроков, сохранённые службой.
#
# Тот же рабочий материал, что и логи матчей, и по той же причине:
# снимаются они у игрока, восстановить их нельзя, но и хранить в истории
# незачем — разбирают их там же, где они легли.
.telemetry/

# Замок замеров частоты кадров. Лежит в корне ОСНОВНОГО дерева и виден
# всем рабочим деревьям сразу: процессор у них общий, и два замера
# одновременно портят оба. Файл живёт секунды и восстановлению не подлежит.
.perf-lock

# Журнал замеров — тоже в корне основного дерева, тоже общий на все.
#
# В репозиторий он не едет намеренно. Числа в нём говорят об ЭТОЙ машине
# и о том, чем она была занята в ту минуту; на другой машине они означают
# другое, а слить два таких журнала в один осмысленный нельзя. Плюс
# несколько сессий дописывали бы его одновременно, и каждый пуш приносил
# бы конфликт в файле, который конфликтовать не должен.
.perf-log.jsonl

# Журнал замеров из контейнера — отдельный от журнала машины намеренно.
# Виртуализация добавляет свой слой, и одна и та же ревизия честно даёт
# разные цифры внутри и снаружи; смешивать их значит сравнивать несравнимое.
.bench-results/

# Рабочие деревья git, заведённые внутри репозитория.
#
# Каждое такое дерево — самостоятельная копия проекта со своей веткой,
# и содержимое у неё своё. Без этой строки `git status` показывает чужое
# дерево как нетронутый каталог, а `git add -A` затаскивает целую копию
# репозитория в коммит.
.claude/worktrees/
