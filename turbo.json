{
  "$schema": "https://turbo.build/schema.json",

  // Файлы, которые влияют на результат любой задачи, но не лежат внутри
  // пакета. Turbo сам добавляет в общий ключ кэша только turbo.json
  // и lock-файл, а `tsconfig.base.json` наследуют все пакеты разом:
  // без этой строки правка строгости компилятора не сбрасывала бы кэш,
  // и `typecheck` отвечал бы «успешно» по результату, снятому до правки.
  //
  // Это особенно важно потому, что кэш у рабочих деревьев ОБЩИЙ: он
  // лежит в `.turbo` основного дерева, и воркри берут ответы оттуда.
  // Замерено 23.08.2026: прогон из воркри записал кэш в основное дерево,
  // своего `.turbo` у воркри не появилось вовсе.
  "globalDependencies": ["tsconfig.base.json"],

  // Корневые команды `test` и `test:match` зовут turbo с
  // `--concurrency=3`, и это не подгонка под конкретную машину.
  // Параллельность здесь вложенная: turbo разводит пакеты, а Vitest
  // внутри каждого поднимает свой пул воркеров по числу ядер. При
  // умолчании в 10 пакетов получалось до семидесяти воркеров на восемь
  // ядер, и прогон падал таймаутами `[vitest-worker]: Timeout calling
  // "fetch"` — каждый раз в разных пакетах, что и выдаёт перегрузку,
  // а не поломку кода. Число оставлено маленьким намеренно: под
  // машину подстраивается Vitest, а turbo нужен лишь затем, чтобы
  // запуски пакетов перекрывались и не ждали друг друга впустую.
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vite.config.ts"],
      "outputs": ["dist/**"],
      // Адреса сервера вшиваются в клиентский бандл на сборке. Turbo
      // по умолчанию не пропускает переменные среды в задачи, а вшитый
      // не тот адрес выглядит как «игра не подключается» — без единой
      // ошибки в логах. Объявлены как `env`, а не `passThroughEnv`:
      // смена адреса обязана менять и ключ кэша, иначе turbo отдаст
      // старую сборку со старым адресом.
      "env": ["VITE_API_URL", "VITE_WS_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      // `vite.config.ts` перечислен наравне с `build`: tsconfig клиента
      // включает этот файл в проверку, поэтому правка конфигурации —
      // такое же изменение входных данных, как правка исходника.
      // Без него turbo отдавал бы старый успешный результат, и ошибка
      // в конфиге доезжала бы до CI незамеченной.
      "inputs": ["src/**", "package.json", "tsconfig.json", "vite.config.ts"]
    },
    // Быстрый набор: всё, кроме тестов, которым нужна партия целиком.
    // Именно эта задача идёт на каждой правке, и от неё зависит,
    // сколько стоит `pnpm verify`.
    //
    // `vitest.config.ts` во входных файлах — не для полноты. Именно
    // там задан состав прогона и его окружение, поэтому правка
    // конфигурации меняет результат ровно так же, как правка кода.
    // Без неё turbo отдавал бы прежний результат на новой настройке,
    // и заметить это по зелёному прогону было бы нельзя.
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json", "vitest.config.ts"]
    },
    // Матчевый набор: тесты, проигрывающие партию. Их тринадцать,
    // и они стоят 84% всего времени прогона, поэтому кеш здесь ценнее
    // всего: правка, не задевшая ядро и противника, отдаёт весь набор
    // из кеша, и полная проверка перед вливанием перестаёт быть
    // поводом сходить за кофе.
    "test:match": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json", "vitest.match.config.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // Turbo не пропускает переменные среды в задачи по умолчанию, так что
      // всё нужное перечислено поимённо. CLIENT_PORT и PORT дают рабочему
      // дереву свою пару портов, а VITE_* — адрес сервера, который клиент
      // иначе взял бы зашитый. Без этого списка `pnpm dev` из второго дерева
      // молча поднимался бы на портах первого.
      "passThroughEnv": [
        "MATCHLOG",
        "MATCHLOG_DIR",
        "PORT",
        "HOST",
        "CLIENT_PORT",
        "VITE_API_URL",
        "VITE_WS_URL"
      ]
    }
  }
}
