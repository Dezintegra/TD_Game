{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vite.config.ts"],
      "outputs": ["dist/**"],
      // Адреса сервера вшиваются в клиентский бандл на сборке. Turbo
      // по умолчанию не пропускает переменные среды в задачи, а вшитый
      // не тот адрес выглядит как «игра не подключается» — без единой
      // ошибки в логах. Объявлены как `env`, а не `passThroughEnv`:
      // смена адреса обязана менять и ключ кэша, иначе turbo отдаст
      // старую сборку со старым адресом.
      "env": ["VITE_API_URL", "VITE_WS_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["MATCHLOG", "MATCHLOG_DIR", "PORT", "HOST"]
    }
  }
}
