# Артефакты OpenSpec.
#
# Их пишет и переписывает `openspec`, а prettier на них НЕ СХОДИТСЯ:
# в `tasks.md` встречаются таблицы внутри вложенных списков, и каждый
# прогон `--write` добавляет им отступ (6 пробелов → 18 → 30), после чего
# `--check` снова недоволен. Проверено 23.08.2026 на восемнадцати файлах:
# два прогона подряд дают два разных результата, и оба «неправильные».
#
# Правильность этих документов проверяет `openspec validate`, а не
# форматтер, — так что потери здесь нет.
openspec/

# Журналы задач конвейера и файл вопросов владельцу продукта.
#
# Оба дозаписываются автоматически: журнал — при каждой смене состояния
# задачи, вопросы — оркестратором по отчёту сессии. Форматтер здесь не
# сторож, а помеха: он превратил бы дозапись в переписывание файла целиком,
# и каждый коммит конвейера приносил бы правки в чужих строках.
manage/journal/
manage/questions.md
manage/board.html

# Записи задач — по той же причине, и она обнаружилась дорого.
#
# Конвейер переписывает файл задачи при каждой смене состояния, а пишет он
# через обычную выкладку JSON: та всегда разворачивает вложенные объекты
# по строкам. Prettier же короткие объекты, наоборот, собирает в строку,
# пока они умещаются в ширину. Два эти правила несовместимы, и первые же
# две задачи, взятые конвейером в работу, уронили проверку формата в главной
# ветке.
#
# Лечить это форматированием на стороне конвейера было бы хуже: он обязан
# переноситься в другой проект копированием каталога, а вызов prettier
# привязал бы его к устройству ЭТОГО репозитория. Годность записи стережёт
# схема, а не форматтер, — и стережёт по существу.
manage/tasks/

# Местные настройки разрешений.
#
# Файл гитом не отслеживается — он закрыт глобальным списком игнорирования,
# — и потому prettier о нём не знает и проверяет как обычный. В CI его нет
# вовсе, а на рабочей машине он ронял бы `format:check` у каждого, кто его
# завёл. Правят его руками и инструментом, а не форматтером.
.claude/settings.local.json

# Рабочие деревья git внутри репозитория — по той же причине, по какой
# они исключены в eslint.config.js: это отдельные копии проекта, и обход
# их отсюда гоняет проверку по всему коду дважды, выдавая чужие ошибки
# в своём отчёте. Названы явно, а не в расчёте на .gitignore: prettier
# читает его по умолчанию, но это поведение флага --ignore-path, и любой
# запуск с другим значением флага снова заглянет внутрь.
.claude/worktrees/
